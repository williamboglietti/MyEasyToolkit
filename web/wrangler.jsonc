{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "myeasytoolkit-distribution",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": ["/"]
  },
  "observability": { "enabled": true }
}
